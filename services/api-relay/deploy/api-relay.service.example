# Review-only template. Nothing in this repository installs or starts it.
[Unit]
Description=Controlled API relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=api-relay
Group=api-relay
WorkingDirectory=/var/lib/api-relay
EnvironmentFile=/etc/api-relay/relay.env
ExecStart=/usr/bin/java -jar /opt/api-relay/current/api-relay.jar --spring.profiles.active=production --spring.config.additional-location=file:/etc/api-relay/policy.yml
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/api-relay
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
