# Review-only schema example. Zero rates deliberately fail startup.
# Supply verified USD-per-million prices for the exact pinned text model/version.
relay:
  trusted-proxy-ips: [127.0.0.1]
  prices:
    - model: REPLACE_PINNED_TEXT_MODEL
      version: REPLACE_PRICE_VERSION
      input-per-million: 0
      cached-per-million: 0
      output-per-million: 0
      max-output: 1024
      max-input: 65536
