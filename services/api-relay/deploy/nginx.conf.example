# Review-only future API virtual host. Requires separately approved DNS/TLS.
# Add the operator-reviewed ssl_certificate/ssl_certificate_key before nginx -t.
server {
    listen 443 ssl;
    server_name api.liangwendev.com;
    client_max_body_size 32k;
    location ^~ /admin { return 404; }
    location ^~ /dashboard { return 404; }
    location = /health { return 404; }
    location /v1/ {
        proxy_pass http://127.0.0.1:19091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
    }
    location / { return 404; }
}
